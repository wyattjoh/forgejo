{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "package-name": "forgejo",
      "release-type": "node",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "extra-files": [
        { "type": "json", "path": "packages/forgejo/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/forgejo-cli/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/forgejo-mcp/package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "README.md" }
      ]
    }
  }
}
