# One Forgejo deployment and one stable HTTPS URL for this MCP deployment.
FORGEJO_HOST=https://git.example.com
MCP_PUBLIC_URL=https://forgejo-mcp.example.com

# Register a confidential Forgejo OAuth application with callback:
# https://forgejo-mcp.example.com/oauth/callback
FORGEJO_OAUTH_CLIENT_ID=
FORGEJO_OAUTH_CLIENT_SECRET=

# Generate once: openssl rand -base64 32
# Keep this stable across restarts; losing it makes stored credentials unreadable.
MCP_ENCRYPTION_KEY=
MCP_DATABASE_PATH=./data/oauth.sqlite

MCP_LISTEN_HOST=127.0.0.1
MCP_PORT=3000
MCP_READ_ONLY=true
# Optional comma-separated Forgejo usernames; empty allows any user of this instance.
MCP_ALLOWED_USERS=
# Optional additional browser-client origins. The public MCP origin is always allowed.
MCP_ALLOWED_ORIGINS=
